# Copy to VPS: /etc/nginx/sites-available/money.ankhang.name.vn
# sudo ln -sf .../money.ankhang.name.vn /etc/nginx/sites-enabled/
# sudo certbot --nginx -d money.ankhang.name.vn

server {
    listen 80;
    listen 443 ssl http2;
    server_name money.ankhang.name.vn;

    client_max_body_size 10M;

    # certbot fills these:
    # ssl_certificate /etc/letsencrypt/live/money.ankhang.name.vn/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/money.ankhang.name.vn/privkey.pem;

    location /api/ {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
