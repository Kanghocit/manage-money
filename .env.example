# PostgreSQL
POSTGRES_USER=moneymanager
POSTGRES_PASSWORD=changeme
POSTGRES_DB=moneymanager
DATABASE_URL=postgres://moneymanager:changeme@postgres:5432/moneymanager?sslmode=disable

# Redis
REDIS_URL=redis://redis:6379/0

# API
API_PORT=8080
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000,http://localhost

# Web (Next.js)
# Dev (Next proxy): /api/v1 — Docker/nginx: http://localhost/api/v1
NEXT_PUBLIC_API_URL=/api/v1
INTERNAL_API_URL=http://localhost:8080/api/v1

# Optional Sentry
SENTRY_DSN=

# Seed admin (optional)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123456

# Storage (local | s3)
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./uploads
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=money-manager
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# OpenAI OCR (optional — without key, mock line items are returned)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
